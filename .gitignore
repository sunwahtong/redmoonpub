# Dependencies and build output
node_modules/
dist/
tsconfig.tsbuildinfo
.verify/
coverage/

# Secrets and local configuration — never committed
.env
.env.*
!.env.example
.mcp.json
.claude/settings.local.json

# Local databases and backups
data/pglite/
data/*.bak
data/*.tmp

# Uploaded media served from disk in development (production uses Cloudinary)
public/assets/dj-music/*
!public/assets/dj-music/.gitkeep
public/assets/uploads/

# Editors and operating systems
.idea/
public/.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
*.swp

# Platform caches
.vercel/
.supabase/
supabase/.temp/

# Retired code kept out of the tree
LEGACY_PROJECT/

# Agent tooling that lands in the checkout
.agents/
skills-lock.json
