# ---------------------------------------------------------------------------
# Red Moon Pub — environment
#
# Local development: copy this file to .env and fill in what you need.
# Vercel: set the same names under Project → Settings → Environment Variables
# (or import this file there). .env is never committed.
#
# Legend:  [REQUIRED]  the site does not work without it
#          [OPTIONAL]  has a sensible default
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database  [REQUIRED on Vercel — leave empty locally to use the embedded DB]
# ---------------------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → "Transaction"
# pooler (port 6543). The direct 5432 connection exhausts the connection
# limit under serverless load.
#
#   postgresql://postgres.hrlgxkcawgumsaudlnma:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# With DATABASE_URL empty the backend runs an embedded PostgreSQL (PGlite)
# under data/pglite/ — zero setup, same schema, same behaviour.
DATABASE_URL=

# Set to "disable" only for a local PostgreSQL without TLS. Leave unset for Supabase.
DB_SSLMODE=

# ---------------------------------------------------------------------------
# Supabase Storage  [REQUIRED on Vercel for DJ uploads; optional locally]
# ---------------------------------------------------------------------------
# Audio uploads go straight from the browser to the bucket through a signed
# URL the API issues; a Vercel function cannot accept 80 MB bodies.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row level security. Server side only:
# never put it in a VITE_ variable, never commit it.
#   Supabase → Project Settings → API keys → service_role (secret)
SUPABASE_URL=https://hrlgxkcawgumsaudlnma.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=dj-music
SUPABASE_MEDIA_BUCKET=media

# ---------------------------------------------------------------------------
# First owner account  [REQUIRED once, on a database with no owner yet]
# ---------------------------------------------------------------------------
# Used exactly once, while no OWNER account exists. Afterwards it has no
# effect — manage accounts in the console at /staff/users.
# The password must be at least 8 characters with a letter and a digit.
OWNER_USERNAME=
OWNER_PASSWORD=
OWNER_NAME=Red Moon Owner

# ---------------------------------------------------------------------------
# Frontend build variables (VITE_ prefix = visible in the browser)  [OPTIONAL]
# ---------------------------------------------------------------------------
# Where the GTA V map tile pack is served from. Empty means /assets/map, which
# is right for a VPS that ships the tiles. On Vercel the tiles are not
# deployed (438 MB); upload them once with `npm run tiles:upload` and point
# the map at the public bucket:
#   VITE_MAP_TILE_BASE=https://hrlgxkcawgumsaudlnma.supabase.co/storage/v1/object/public/map-tiles
VITE_MAP_TILE_BASE=

# ---------------------------------------------------------------------------
# Runtime  [OPTIONAL]
# ---------------------------------------------------------------------------
# Port the local API server listens on (`npm run server`). Vite proxies to it.
PORT=3000
# Vercel sets VERCEL=1 itself. RM_SERVERLESS=1 forces the serverless code path
# locally, to test it without deploying.
RM_SERVERLESS=
