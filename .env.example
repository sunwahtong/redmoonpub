# Local development only. On a host these come from the dashboard.
# Copy to .env and fill in what you need. .env is never committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL empty to use the local data/seed.json file instead.
#
# Supabase: use the *pooler* connection string, not the direct one.
#   Project -> Connect -> "Transaction pooler"
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Port 6543 is the pooler. Port 5432 is a direct connection and will exhaust
# the connection limit as soon as more than a handful of functions are warm.
DATABASE_URL=

# Set to "disable" only for a local PostgreSQL without TLS.
# Leave it unset for Supabase, Render and any other hosted database.
DB_SSLMODE=disable

# Port the API server listens on. Render and most hosts set this themselves.
PORT=3000

# ---------------------------------------------------------------------------
# First owner account
# ---------------------------------------------------------------------------
# Used exactly once, while the database is still empty. Setting it afterwards
# has no effect — create further accounts in the app at /staff/users.
OWNER_USERNAME=
OWNER_PASSWORD=
OWNER_NAME=Red Moon Owner

# ---------------------------------------------------------------------------
# Object storage (Vercel only)
# ---------------------------------------------------------------------------
# A Vercel function has a read-only filesystem, so uploaded DJ audio has to go
# somewhere else. With these set, uploads go to a Supabase Storage bucket; with
# them empty, uploads are written to public/assets/dj-music/ as before.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row level security. Server side only.
# Never put it in a VITE_ variable and never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=dj-music

# ---------------------------------------------------------------------------
# Frontend build variables (VITE_ prefix = visible in the browser)
# ---------------------------------------------------------------------------
# Where the map tile pack is served from. Empty means /assets/map, which is
# correct for a VPS or Render deployment that ships the tiles.
# On Vercel the tiles are not deployed; point this at the public bucket:
#   VITE_MAP_TILE_BASE=https://<ref>.supabase.co/storage/v1/object/public/map-tiles
VITE_MAP_TILE_BASE=

# ---------------------------------------------------------------------------
# Runtime override
# ---------------------------------------------------------------------------
# Vercel sets VERCEL=1 itself. Set RM_SERVERLESS=1 to force the serverless
# code path locally, to test it without deploying.
RM_SERVERLESS=
