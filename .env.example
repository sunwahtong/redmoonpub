# ---------------------------------------------------------------------------
# Database  [REQUIRED in production]
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Empty means the embedded database under
# data/pglite/: the right choice for local development, so nothing local ever
# touches production data or spends Supabase's egress. In production:
# Supabase → Connect → Session pooler (port 5432; the long-lived process
# keeps a few connections open, which is what that mode is for).
DATABASE_URL=
# "disable" only for a database without TLS.
DB_SSLMODE=

# ---------------------------------------------------------------------------
# Supabase Realtime  [OPTIONAL]
# ---------------------------------------------------------------------------
# The backend broadcasts small "something changed" messages; browsers refetch.
# The publishable key (sb_publishable_…) is public by design and enough for
# this. Without these the site still works, it just polls a little more often.
#   Supabase → Project Settings → API keys → Publishable key
SUPABASE_URL=https://hrlgxkcawgumsaudlnma.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_IBbHeBtwgC2x-4KFsbDq-w_e_SevtcJ
# Optional, server side only (sb_secret_…): used for broadcasts when set, and
# by `npm run tiles:upload`. Never in a VITE_ variable, never committed.
#   Supabase → Project Settings → API keys → Secret keys
SUPABASE_SECRET_KEY=

# The browser needs the same two values to subscribe (VITE_ = visible in the browser).
VITE_SUPABASE_URL=https://hrlgxkcawgumsaudlnma.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_IBbHeBtwgC2x-4KFsbDq-w_e_SevtcJ

# ---------------------------------------------------------------------------
# Cloudinary — every picture and audio file  [REQUIRED in production for uploads]
# ---------------------------------------------------------------------------
# Gallery pictures, event covers, product images and DJ tracks are uploaded
# from the browser straight to Cloudinary with a signature this server
# computes. Without credentials (local development) uploads land under
# public/assets/uploads/ instead.
#
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder in the account. Everything the site uploads lives under it.
CLOUDINARY_FOLDER=redmoon

# The site's own pictures and the background music are served from Cloudinary
# once you mirror public/assets there with `npm run media:upload` (needs the
# three values above locally). Set the cloud name here afterwards; empty means
# they are served from the deployment itself, which also works.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_FOLDER=redmoon

# Override the background music file (default: /assets/red-moon.mp3, or its
# Cloudinary copy once VITE_CLOUDINARY_CLOUD_NAME is set).  [OPTIONAL]
VITE_BACKGROUND_MUSIC_URL=

# ---------------------------------------------------------------------------
# First owner account  [REQUIRED once, on a database with no owner yet]
# ---------------------------------------------------------------------------
# Used exactly once, while no OWNER account exists. Afterwards it has no
# effect — manage accounts in the console at /staff/users.
# The password must be at least 8 characters with a letter and a digit.
OWNER_USERNAME=
OWNER_PASSWORD=
OWNER_NAME=Red Moon Owner

# ---------------------------------------------------------------------------
# Map tiles  [OPTIONAL]
# ---------------------------------------------------------------------------
# Where the GTA V map tile pack is served from. Empty means /assets/map on this
# server (map-tiles/: Node serves it locally, nginx on the VPS). Only set it if
# the pack is ever published to a static host. See README → Map tiles.
VITE_MAP_TILE_BASE=

# ---------------------------------------------------------------------------
# Runtime  [OPTIONAL]
# ---------------------------------------------------------------------------
# Port and interface the server listens on. Vite proxies to :3000 in
# development. On the VPS HOST=127.0.0.1, so only nginx reaches Node; empty
# means every interface.
PORT=3000
HOST=
# Vercel sets VERCEL=1 itself. RM_SERVERLESS=1 forces the serverless code path
# locally, to test it without deploying.
RM_SERVERLESS=
